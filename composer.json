{
  "name": "errorgap/errorgap",
  "description": "PHP notifier for Errorgap error tracking.",
  "type": "library",
  "license": "MIT",
  "keywords": ["errorgap", "error-tracking", "exceptions", "monitoring"],
  "homepage": "https://github.com/errorgaphq/errorgap-php",
  "authors": [{ "name": "Errorgap" }],
  "require": {
    "php": "^8.1",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "monolog/monolog": "^3.0",
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10"
  },
  "suggest": {
    "monolog/monolog": "To report error-level log records with Errorgap\\Monolog\\Handler (^3.0)"
  },
  "autoload": {
    "psr-4": { "Errorgap\\": "src/Errorgap/" }
  },
  "autoload-dev": {
    "psr-4": { "Errorgap\\Tests\\": "tests/" }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.7.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse src --level=8"
  }
}
